# Copy to .env and edit. Never commit .env.

# Port the app listens on (published on the host too).
PORT=8080

# Database. Use a long random alphanumeric password, eg: openssl rand -hex 24
POSTGRES_DB=patchy
POSTGRES_USER=patchy
POSTGRES_PASSWORD=change-me-to-a-random-hex-string

# true when users reach Patchy over HTTPS (reverse proxy). Set false ONLY if you browse to
# plain http://<lan-ip>:PORT directly, otherwise the browser drops the session cookie.
COOKIE_SECURE=true
SESSION_HOURS=12

# IP of your reverse proxy (Nginx Proxy Manager / Caddy) so client IPs in the audit log and
# rate limits come from X-Forwarded-For. Comma-separated. Leave as is if not using a proxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional: GitHub token for private repos and higher API limits (5000/h vs 60/h).
# Use a fine-grained token with read-only "Contents" and "Metadata" on chosen repos.
GITHUB_TOKEN=

# Vulnerability feeds
OSV_ENABLED=true
KEV_ENABLED=true
NVD_ENABLED=false
# v1.1 sources. Each can also be switched on/off and rescheduled on the Settings page.
NVD_CPE_ENABLED=true
EPSS_ENABLED=true
EOL_ENABLED=true
# Needs GITHUB_TOKEN with the 'Dependabot alerts: read' permission.
DEPENDABOT_ENABLED=true
# Optional NVD API key (raises the NVD limit from 5 to 50 requests per 30 s).
NVD_API_KEY=
# Hours between automatic full refreshes (0 = manual only) and when data counts as stale.
# Default schedule for every source (0 = manual only). Settings page overrides it per source.
FEED_REFRESH_HOURS=24
FEED_STALE_HOURS=72
# Upper bounds per refresh so a large inventory never causes unbounded API traffic.
OSV_MAX_QUERIES_PER_REFRESH=5000
OSV_MAX_ADVISORY_FETCH_PER_REFRESH=2000
OSV_MAX_VULNS_PER_PACKAGE=200
NVD_MAX_PER_REFRESH=50
NVD_CPE_MAX_PER_REFRESH=100

# Alerts (optional). Set any of these; every one set gets every alert. Choose what alerts in Settings > Alerts.
# The address you open Patchy on, for links in alerts, eg https://patchy.example.lan
PATCHY_URL=
# JSON POST of {title, message, url, items}. Works with a Home Assistant webhook trigger:
# http://homeassistant.local:8123/api/webhook/<id>. Treat the URL as a password.
ALERT_WEBHOOK_URL=
# ntfy: the full topic URL, eg https://ntfy.sh/<long-random-topic>, plus a token if the topic needs one.
ALERT_NTFY_URL=
ALERT_NTFY_TOKEN=
# Email. Port 465 uses TLS from the start; other ports use STARTTLS unless SMTP_STARTTLS=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# Largest agent report accepted, in bytes (image package lists make reports bigger).
AGENT_MAX_REPORT_BYTES=33554432

# Repository scan limits
REPO_MAX_FILE_BYTES=5242880
REPO_MAX_TOTAL_BYTES=52428800
REPO_MAX_MANIFESTS=300
REPO_SCAN_TIMEOUT_SECONDS=180

# Serve Swagger UI at /api/docs (loads assets from a CDN). The raw schema at
# /api/openapi.json is always available.
ENABLE_API_DOCS=false
