{
  "server_url": "https://patchy.example.lan",
  "token_file": "/etc/patchy-agent/token",
  "ca_file": null,
  "allow_insecure_http": false,
  "timeout_seconds": 30,
  "collect": {
    "packages": true,
    "apps": true,
    "listening_ports": true,
    "services": true,
    "in_use": true,
    "updates": true,
    "docker_images": false,
    "image_packages": true,
    "image_scan": "manual",
    "version_probes": ["nginx", "apache2", "httpd", "caddy", "python3", "node", "openssl", "openssh", "docker"]
  },
  "app_dirs": []
}
